{
  "name": "vault",
  "version": "0.1.3",
  "description": "QA productivity tool \u2014 clipboard, screenshots, recordings",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_IS_DEV=1 electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:mac:dir": "electron-builder --mac dir",
    "prebuild:mac": "npm version patch --no-git-tag-version",
    "ship": "tccutil reset ScreenCapture com.vault.app; rm -rf /Applications/Vault.app; npm run build:mac && open dist/"
  },
  "author": "Tina Heigl",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.vault.app",
    "productName": "Vault",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Vault",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
